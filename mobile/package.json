{
  "name": "kani-mobile",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "model": "node scripts/package-model.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test test/*.test.mjs",
    "sync": "npm run build && cap sync",
    "sync:android": "npm run build && cap sync android",
    "sync:ios": "npm run build && cap sync ios",
    "android": "cap open android",
    "ios": "cap open ios",
    "apk": "npm run sync:android && node scripts/build-android.mjs",
    "ios:build": "node scripts/build-ios.mjs",
    "release:prepare": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-mlkit/image-labeling": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor-mlkit/translation": "^8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "firebase": "^12.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
